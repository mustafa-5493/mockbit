# ─────────────────────────────────────────────────────────────
# Mockbit — Environment Variable Template
#
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Required for DB & Auth) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Anthropic Claude API (Required for AI Schema Generation) ────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Upstash Redis (Required for Fast Rate Limiting) ───────────
UPSTASH_REDIS_REST_URL=https://your-redis-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── App Configuration ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
